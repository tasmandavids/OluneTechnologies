# Copy to .env.local and fill in (Supabase → Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Service-role key — used only by webhook + cron handlers (bypasses RLS). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional — only for Supabase CLI (npx supabase login / db push). Not needed when GitHub integration deploys migrations.
# SUPABASE_ACCESS_TOKEN=your-personal-access-token
# Database password for `supabase link` / `db push` (Project Settings → Database).
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_PROJECT_REF=wnoxcwihrzbxvogvmhqv

# Shared secret for the notifications cron. Vercel Cron sends it as a Bearer token.
CRON_SECRET=generate-a-long-random-string

# OAuth — see docs/OAUTH_SETUP.md. Run: node --env-file=.env.local scripts/setup-oauth.mjs
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Connected inbox OAuth (separate from login — needs Gmail / Graph mail scopes).
# Gmail: use a dedicated OAuth client or reuse GOOGLE_OAUTH_* with Gmail API enabled.
# GOOGLE_MAIL_CLIENT_ID=
# GOOGLE_MAIL_CLIENT_SECRET=
# Microsoft: Azure App Registration → Mail.Read, Mail.Send, offline_access.
# MICROSOFT_MAIL_CLIENT_ID=
# MICROSOFT_MAIL_CLIENT_SECRET=
# MICROSOFT_MAIL_TENANT=common

# Encrypts stored mailbox credentials (required in production).
EMAIL_TOKEN_ENCRYPTION_KEY=generate-a-long-random-string
EMAIL_OAUTH_STATE_SECRET=generate-a-long-random-string

# Xero accounting — see docs/XERO_SETUP.md
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=http://localhost:3000/api/xero/oauth/callback
# Production: https://www.olune.co.nz/api/xero/oauth/callback
# XERO_TOKEN_ENCRYPTION_KEY=generate-a-long-random-string
# XERO_OAUTH_STATE_SECRET=generate-a-long-random-string
# Signing key from the Xero app's Webhooks tab — verifies /api/webhooks/xero
# XERO_WEBHOOK_KEY=
# Required in production (no CRON_SECRET fallback).

# Optional — AI conversation summaries (falls back to heuristic summary without this).
# OPENAI_API_KEY=
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
# OPENAI_ADS_MODEL=gpt-4o-mini
# OPENAI_SEO_MODEL=gpt-4o-mini

# Social advertising — Meta (Facebook + Instagram) and TikTok OAuth.
# Meta: developers.facebook.com → create app → add Facebook Login + Marketing API.
# META_APP_ID=
# META_APP_SECRET=
# TikTok: developers.tiktok.com → create app → Login Kit + Content Posting API.
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# ADVERTISING_OAUTH_STATE_SECRET=generate-a-long-random-string
# ADVERTISING_TOKEN_ENCRYPTION_KEY=generate-a-long-random-string

# Canonical app URL for OAuth (email + Xero), notification links, and cron jobs.
# Local: http://localhost:3000
# Production (Olune): https://www.olune.co.nz  (must include https://)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tenant subdomain root. Local: localhost  |  Production: olune.co.nz
# Studio sites: https://<slug>.olune.co.nz  — OAuth always uses NEXT_PUBLIC_APP_URL above.
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Custom domain DNS targets (shown in the domain setup wizard).
NEXT_PUBLIC_DOMAIN_CNAME_TARGET=cname.vercel-dns.com
NEXT_PUBLIC_DOMAIN_APEX_IP=216.198.79.1

# Custom domain registration. Pointing DNS at us is only half the job — Vercel
# serves nothing (and issues no TLS certificate) for a hostname the project
# hasn't claimed, so a studio's domain 404s until it's added via the API.
# Without these the wizard still saves the domain, but tells the admin the last
# step has to be finished by Olune rather than claiming the domain is live.
#   Token:      vercel.com/account/settings/tokens  (needs project write scope)
#   Project ID: Project Settings → General → Project ID (prj_…)
#   Team ID:    only when the project is team-owned (team_…)
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...

# Stripe (Dashboard → Developers → API keys).
STRIPE_SECRET_KEY=sk_test_...
# Optional restricted key (Dashboard → Create restricted key). Not read by app code.
# STRIPE_RESTRICTED_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Publishable key is exposed to the browser for Stripe.js / PaymentElement.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Connect — per-studio Accounts v2 (Dashboard → Connect → Settings).
# Signing key for the SECOND webhook endpoint subscribed to Connect events
# (account.updated etc.), pointed at /api/webhooks/stripe-connect.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Signing key for the THIRD endpoint, /api/webhooks/stripe-v2. Studio accounts
# are Accounts v2 and their status events cannot be added to a classic webhook
# endpoint — Stripe rejects the names — so they arrive via an Event Destination
# with its own secret. Register it and print the secret with:
#   node --env-file=.env.local scripts/setup-v2-event-destination.mjs \
#     --url https://<host>/api/webhooks/stripe-v2
# Unset, a studio Stripe restricts later keeps looking chargeable until the
# nightly /api/cron/sync-connect-accounts sweep notices.
STRIPE_V2_WEBHOOK_SECRET=whsec_...
# HMAC secret for signing the Connect onboarding state token. Falls back to
# EMAIL_OAUTH_STATE_SECRET / CRON_SECRET in development if unset.
# STRIPE_CONNECT_STATE_SECRET=generate-a-long-random-string

# Settings → Connections (the integrations hub): encryption for stored API keys
# and HMAC for the OAuth state token. Fall back to EMAIL_* / CRON_SECRET in
# development if unset.
# INTEGRATIONS_TOKEN_ENCRYPTION_KEY=generate-a-long-random-string
# INTEGRATIONS_OAUTH_STATE_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
#  PRODUCTION: the commented-out *_TOKEN_ENCRYPTION_KEY / *_OAUTH_STATE_SECRET
#  pairs above are optional ONLY in development. In production every one of
#  them is mandatory — lib/env/required-secret.ts refuses the fallback when
#  NODE_ENV=production and throws instead, from inside a crypto helper, at
#  request time. A missing one therefore looks perfect locally and takes the
#  matching feature down in prod with no startup warning.
#
#  The authoritative list is PRODUCTION_REQUIRED_SECRETS in
#  lib/env/required-secret.ts. To check a live deployment:
#
#    curl -H "Authorization: Bearer $CRON_SECRET" \
#      https://www.olune.co.nz/api/health/secrets
#
#  Generate any of them with: openssl rand -base64 32
# ---------------------------------------------------------------------------

# Comma-separated emails with access to /platform (Olune operator console).
# Also insert into platform_operators for persistent access without env changes.
# Test seed account: platform-admin@olune.test (see TEST_ACCOUNTS.md)
PLATFORM_OPERATOR_EMAILS=platform-admin@olune.test


# Outbound notification delivery (OPTIONAL — delivery no-ops if unset).
# Email via Resend (https://resend.com → API Keys). RESEND_FROM must be an
# address on a domain VERIFIED in Resend → Domains — sending from an
# unverified domain is a 403, not a bounce. Setting only one of the two leaves
# email unconfigured and every send is silently skipped, so set both or neither.
# Check a deployment with: curl -H "Authorization: Bearer $CRON_SECRET" \
#   https://www.olune.co.nz/api/health/secrets   → read `delivery`.
RESEND_API_KEY=re_...
RESEND_FROM=Olune <noreply@olune.co.nz>
# Reply-to for OLUNE'S OWN mail to studios. Studio-branded mail (invoices,
# reminders, mass email) overrides this per-send with the studio's own address
# — see lib/notify/reply-to.ts. Do not treat this as a global reply-to: pointed
# at support@ without that override, every parent reply lands in Olune support.
RESEND_REPLY_TO=support@olune.co.nz
# NOTE: this key covers app email only (invoices, reminders, invites sent by
# our own code). Supabase Auth's own mail — password reset, magic link, the
# invite link itself — goes out over Supabase's SMTP, which is capped at
# 2/hour on the built-in sender. That is configured separately in the Supabase
# dashboard (Auth → SMTP Settings) against smtp.resend.com:587, user `resend`,
# password = a Resend API key. Both must be set for email to actually work.
# SMS via Twilio (Console → Account Info + a Messaging number in E.164).
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM=+6421234567


# Apple Wallet passes for NFC check-in cards (OPTIONAL — the "Add to Apple
# Wallet" button is hidden entirely when unset). Requires a Pass Type ID
# certificate from developer.apple.com; see docs/APPLE_WALLET.md for how to
# produce these five values.
# APPLE_WALLET_PASS_TYPE_ID=pass.co.olune.checkin
# APPLE_WALLET_TEAM_ID=ABCDE12345
# PEMs may be pasted with real newlines or base64-encoded (both are accepted).
# APPLE_WALLET_SIGNER_CERT=-----BEGIN CERTIFICATE-----...
# APPLE_WALLET_SIGNER_KEY=-----BEGIN PRIVATE KEY-----...
# APPLE_WALLET_SIGNER_KEY_PASSPHRASE=only-if-the-key-is-encrypted
# APPLE_WALLET_WWDR_CERT=-----BEGIN CERTIFICATE-----...


# Error monitoring via Sentry (OPTIONAL — the SDK installs but never sends
# when NEXT_PUBLIC_SENTRY_DSN is unset, so local dev and CI behave as before).
# The DSN is public by design: it identifies the project, it does not grant
# read access. Its ingest host is added to the CSP's connect-src automatically
# (next.config.ts), so no header change is needed when you set it.
# NEXT_PUBLIC_SENTRY_DSN=https://<publicKey>@o0.ingest.us.sentry.io/0
#
# Sampling for performance traces only — errors are always sent. Defaults to
# 0.1 in production and 1 everywhere else.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
#
# Overrides the environment shown on each event. Leave unset on Vercel, where
# VERCEL_ENV already gives production / preview / development.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
#
# Build-time only, for uploading source maps so stack traces are readable.
# Without SENTRY_AUTH_TOKEN the upload is skipped and the build still passes —
# set all three in Vercel, not locally. The token needs project:releases scope.
# SENTRY_ORG=olune
# SENTRY_PROJECT=olune-web
# SENTRY_AUTH_TOKEN=sntrys_...


# Shared rate-limit store (OPTIONAL, but see the warning below).
# Without it the limiter falls back to an in-process window, which on Vercel
# means each serverless instance keeps its own counter — the effective limit
# becomes `limit × instance_count`, a number you cannot see or control. Fine
# for local dev; not a real control in production.
#
# Either naming works, so it can be provisioned through Upstash directly or as
# a Vercel KV / Marketplace integration (which sets the KV_ names for you).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token
#   ...or...
# KV_REST_API_URL=https://your-db.kv.vercel-storage.com
# KV_REST_API_TOKEN=your-rest-token
