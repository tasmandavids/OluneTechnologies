.claude/settings.local.json

# dependencies
node_modules/

# next.js
/.next
/out
next-env.d.ts
*.tsbuildinfo

# env & secrets
# Broad on purpose: .env*.local alone let a plain `.env` or an
# `.env.production` through, and those hold the same live keys.
# .env.local.example is already tracked, so it is unaffected.
.env*
.env.vercel.*

# vercel
.vercel

# supabase cli (local link state — not for git)
supabase/.temp/
supabase/.branches/

