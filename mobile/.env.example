# Copy to .env. EXPO_PUBLIC_* values are inlined into the JS bundle — that is
# correct for the anon key (public by design; RLS is the boundary) and must
# NEVER be done with the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The one origin Olune sends parents links on. Must match the web's
# NEXT_PUBLIC_APP_URL, or deep links will not open the app.
EXPO_PUBLIC_API_BASE_URL=https://www.olune.co.nz

# Written by `npx eas init`.
EAS_PROJECT_ID=

# Optional overrides — only for a per-studio white-label build.
# OLUNE_BUNDLE_ID=nz.co.olune.parent
# OLUNE_CANONICAL_HOST=www.olune.co.nz
